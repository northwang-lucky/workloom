node_modules/
dist/
# dist 入库例外：core 与 dsh-workloom 的构建产物随源码提交，git 子目录安装免构建
!packages/core/dist/
!packages/dsh-workloom/dist/
# 发版时从根目录复制共享文档到包目录，随 npm 包发布，不单独入库
packages/core/CHANGELOG.md
packages/dsh-workloom/CHANGELOG.md
packages/dsh-workloom/README.md
packages/dsh-workloom/README.en.md
*.tsbuildinfo
.DS_Store
*.log

# 个人本地规则（每台机器各自维护）
AGENTS.local.md

# workloom 本地配置覆盖（每台机器各自维护）
.workloom/config.local.json
.workloom/config.local.js

# pi 项目本地状态目录（pi-loop 等全局包在本目录运行 pi 时生成）
.pi/
