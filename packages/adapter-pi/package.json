{
  "name": "@workloom/adapter-pi",
  "version": "0.0.0",
  "description": "workloom 的 Pi adapter：Pi Package（Extension 事件注入/命令/executor，严格依赖 pi-subagents）",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "skills"
  ],
  "scripts": {
    "build": "node scripts/sync-skills.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test 'test/*.test.ts'"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "keywords": [
    "pi-package",
    "workloom"
  ],
  "dependencies": {
    "@workloom/assets": "file:../assets",
    "@workloom/core": "file:../core"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "pi-subagents": "^0.53.0",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
