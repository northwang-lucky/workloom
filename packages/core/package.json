{
  "name": "@workloom-ai/core",
  "version": "0.1.0",
  "description": "runtime 无关核心：任务状态机、注入组装、workspace 与 git 能力，含 resources 内容目录",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "resources"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-domain-dts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/*.test.ts' 'resources/skills/workloom-packages-scan/scripts/*.test.ts' 'resources/scripts/*.test.mjs'"
  },
  "dependencies": {
    "yaml": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
