function combineFormats(formats: CoverageFormat[]): CoverageFormat {
  const first = formats[0]
  if (first === undefined || formats.includes('unsupported')) return 'unsupported'
  return formats.every((format) => format === first) ? first : 'mixed'
}
export function meetsThreshold(
  covered: number,
  total: number,
  threshold: number = DEFAULT_THRESHOLD,
): boolean {
  return covered * 100 > total * threshold
