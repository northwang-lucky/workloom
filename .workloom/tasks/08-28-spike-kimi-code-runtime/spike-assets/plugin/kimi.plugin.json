{
  "name": "workloom-spike",
  "version": "0.1.0",
  "description": "workloom adapter-kimi spike probe plugin",
  "skills": "./skills/",
  "commands": "./commands/",
  "sessionStart": {
    "skill": "contract"
  },
  "mcpServers": {
